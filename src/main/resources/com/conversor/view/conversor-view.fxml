<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.conversor.controller.ConversorController">

    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Conversor de Arquivos" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Seleção de arquivo -->
    <VBox alignment="CENTER" spacing="8.0">
        <Button fx:id="btnSelecionarArquivo" text="Selecionar Arquivo" onAction="#onSelecionarArquivo"/>
        <Label fx:id="lblArquivoSelecionado" text="Nenhum arquivo selecionado" style="-fx-text-fill: gray;"/>
    </VBox>

    <!-- Escolha do formato de destino -->
    <VBox alignment="CENTER" spacing="8.0">
        <Label text="Converter para:"/>
        <ComboBox fx:id="comboFormatoDestino" prefWidth="200.0" disable="true"/>
    </VBox>

    <!-- Ação de converter -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="btnConverter" text="Converter" onAction="#onConverter" disable="true"/>
        <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="24.0" prefHeight="24.0"/>
    </HBox>

    <!-- Mensagem de status/resultado -->
    <Label fx:id="lblStatus" wrapText="true" style="-fx-font-size: 13px;"/>

</VBox>
